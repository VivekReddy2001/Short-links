<%- include('partials/header', { title: 'Short-links — shorten a URL' }) %>

<section class="hero">
    <h1>Turn a long URL into a short one</h1>
    <p class="muted">No account needed. Sign in if you want to pick a custom alias or keep track of your links.</p>

    <form class="shorten-form" method="POST" action="/">
        <input
            type="url"
            name="longUrl"
            placeholder="https://example.com/a/very/long/path"
            value="<%= longUrl %>"
            required
        />
        <button type="submit" name="submit" value="Generate Short URL">Shorten</button>
    </form>

    <% if (error) { %>
        <p class="error"><%= error %></p>
    <% } %>

    <% if (shortUrl) { %>
        <div class="result">
            <p>Your short link:</p>
            <a class="short-link" href="<%= shortUrl %>"><%= shortUrl %></a>
        </div>
    <% } %>

    <% if (!user) { %>
        <p class="muted">
            Want a memorable alias instead of a random code, and a dashboard of everything you've shortened?
            <a href="/register">Create an account</a> — it's free.
        </p>
    <% } %>
</section>

<%- include('partials/footer') %>
