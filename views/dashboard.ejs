<%- include('partials/header', { title: 'Dashboard — Short-links' }) %>

<section class="dashboard">
    <h1>Your links</h1>
    <% if (error) { %>
        <p class="error"><%= error %></p>
    <% } %>

    <div class="dashboard-grid">
        <div class="panel">
            <h2>Create a custom link</h2>
            <form method="POST" action="/app/">
                <%- include('partials/csrf') %>
                <label>Destination URL
                    <input type="url" name="longUrl" placeholder="https://example.com/..." required />
                </label>
                <label>Custom alias
                    <input type="text" name="customCode" placeholder="my-link" minlength="3" maxlength="32" required />
                </label>
                <label>Note (optional, searchable)
                    <input type="text" name="description" maxlength="200" placeholder="e.g. spring campaign landing page" />
                </label>
                <button type="submit">Create</button>
            </form>
        </div>

        <div class="panel">
            <h2>New collection</h2>
            <form method="POST" action="/addcollections">
                <%- include('partials/csrf') %>
                <label>Name
                    <input type="text" name="name" placeholder="e.g. Marketing" required />
                </label>
                <button type="submit">Add collection</button>
            </form>
        </div>
    </div>

    <form class="search-form" method="GET" action="/dashboard" role="search">
        <input type="search" name="q" value="<%= q %>" placeholder="Search your links by note, destination or alias" maxlength="100" />
        <button type="submit">Search</button>
        <% if (q) { %>
            <a href="/dashboard">Clear</a>
            <span class="muted"><%= resultCount %> match<%= resultCount === 1 ? '' : 'es' %> for “<%= q %>”</span>
        <% } %>
    </form>

    <% function urlRow(url) { %>
        <li class="url-row">
            <div>
                <a class="short-link" href="<%= host %>/<%= url.shortUrl %>"><%= host %>/<%= url.shortUrl %></a>
                <span class="muted">→ <%= url.longUrl %></span>
                <% if (url.description) { %>
                    <div class="note"><%= url.description %></div>
                <% } %>
            </div>
            <div class="url-meta">
                <span class="clicks"><%= url.clicks %> click<%= url.clicks === 1 ? '' : 's' %></span>
                <form method="POST" action="/change_collection" class="inline-form">
                    <%- include('partials/csrf') %>
                    <input type="hidden" name="urlId" value="<%= url._id %>" />
                    <select name="collectionId" onchange="this.form.submit()">
                        <option value="">Uncategorized</option>
                        <% collections.forEach(function (c) { %>
                            <option value="<%= c._id %>" <%= url.collectionId && String(url.collectionId) === String(c._id) ? 'selected' : '' %>>
                                <%= c.name %>
                            </option>
                        <% }) %>
                    </select>
                </form>
                <form method="POST" action="/links/<%= url._id %>/delete" class="inline-form"
                      onsubmit="return confirm('Delete this link? Its short code will stop working.')">
                    <%- include('partials/csrf') %>
                    <button type="submit" class="danger-button" aria-label="Delete <%= url.shortUrl %>">Delete</button>
                </form>
            </div>
        </li>
    <% } %>

    <% if (q && resultCount === 0) { %>
        <p class="muted">No links match that search.</p>
    <% } else if (collections.length === 0 && uncategorized.length === 0) { %>
        <p class="muted">You haven't shortened anything yet — use the form above, or the one on the <a href="/">home page</a>.</p>
    <% } %>

    <% collections.forEach(function (collection) { %>
        <% if (q && !urlsByCollection.get(String(collection._id))) { return; } %>
        <div class="collection-heading">
            <h2><%= collection.name %></h2>
            <form method="POST" action="/collections/<%= collection._id %>/delete" class="inline-form"
                  onsubmit="return confirm('Delete this collection? Its links are kept and moved to Uncategorized.')">
                <%- include('partials/csrf') %>
                <button type="submit" class="danger-button">Delete collection</button>
            </form>
        </div>
        <ul class="url-list">
            <% (urlsByCollection.get(String(collection._id)) || []).forEach(function (url) { %>
                <%- urlRow(url) %>
            <% }) %>
            <% if (!urlsByCollection.get(String(collection._id))) { %>
                <li class="muted">No links here yet.</li>
            <% } %>
        </ul>
    <% }) %>

    <% if (uncategorized.length > 0) { %>
        <h2>Uncategorized</h2>
        <ul class="url-list">
            <% uncategorized.forEach(function (url) { %>
                <%- urlRow(url) %>
            <% }) %>
        </ul>
    <% } %>
</section>

<%- include('partials/footer') %>
