{
  "name": "short-links",
  "version": "1.0.0",
  "description": "A small self-hosted URL shortener: anyone can shorten a link, and signed-in users get custom aliases, click counts, and collections to file links into.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "jest --runInBand",
    "lint": "eslint ."
  },
  "keywords": [
    "url-shortener",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "Vivek Reddy (https://github.com/VivekReddy2001)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.5",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.10.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VivekReddy2001/Short-links.git"
  }
}
