# Copy this file to .env and fill in real values. .env is git-ignored.

# MongoDB connection string. A free Atlas cluster works fine, or a local
# mongod at mongodb://127.0.0.1:27017/short-links.
MONGODB_URI=mongodb://127.0.0.1:27017/short-links

# Any long random string — used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

PORT=3000
